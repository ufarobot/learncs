---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';

const title = 'Ученикам — learncs.ru';
const description = 'Курсы LearnCS, учебник, игры для информатики, задания и инструкции по установке программ.';
const canonical = new URL('students/', site.url).href;

const linkGroups = [
  {
    "id": "courses",
    "title": "Курсы и задания",
    "links": [
      {
        "label": "Мои курсы в LMS",
        "href": "https://lms.learncs.ru/dashboard",
        "note": "Войдите в аккаунт LearnCS и откройте свой курс."
      }
    ]
  },
  {
    "id": "materials",
    "title": "Учебник и игры",
    "links": [
      {
        "label": "Игры для информатики",
        "href": "/game/",
        "note": "Игры по темам информатики 7–9 классов: скриншоты, цены и отзывы."
      },
      {
        "label": "Учебник LearnCS",
        "href": "https://book.learncs.ru/",
        "note": "Материалы по математике, информатике и программированию. Учебник пополняется."
      }
    ]
  },
  {
    "id": "tools",
    "title": "Подготовка компьютера",
    "note": "Устанавливайте программы, которые указал преподаватель.",
    "links": [
      {
        "label": "Python и PyCharm: установка",
        "href": "/software/",
        "note": "Инструкции на русском языке, установщики и запуск первой программы."
      },
      {
        "label": "IntelliJ IDEA",
        "href": "https://www.jetbrains.com/ru-ru/idea/download/",
        "note": "Официальная страница загрузки. Выберите версию для своей операционной системы."
      },
      {
        "label": "Стартовый проект Карела",
        "href": "https://lms.learncs.ru/asset-v1:Ishimbaev+Karel+2026+type@asset+block@M1_Karel.zip",
        "note": "Для курса по Карелу: скачайте архив, распакуйте и откройте папку проекта в IntelliJ IDEA."
      },
      {
        "label": "Среды программирования на олимпиадах",
        "href": "/software/olympiads/",
        "note": "Подтверждённые требования организаторов и ссылки на источники."
      }
    ]
  },
  {
    "id": "practice",
    "title": "Другие платформы для заданий",
    "links": [
      {
        "label": "Code.org",
        "href": "https://studio.code.org/users/sign_in",
        "note": "Если преподаватель назначил задания на Code.org, войдите в свой аккаунт."
      },
      {
        "label": "Informatics",
        "href": "https://informatics.msk.ru/enrol/index.php?id=5742",
        "note": "Открывайте, если преподаватель дал ссылку на этот курс."
      },
      {
        "label": "Informatics: запасной адрес",
        "href": "https://informatics.mccme.ru/enrol/index.php?id=5742",
        "note": "Используйте, если основной адрес не открывается."
      }
    ]
  }
];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  courseSchema={false}
  showHeaderCta={false}
  showFooterCta={false}
  basePath="../"
>
  <section class="section resource-page">
    <div class="container">
      <div class="section-head resource-page-head">
        <p class="pretitle">learncs.ru</p>
        <h1>Ученикам</h1>
        <p>Курсы, задания, учебник и программы для занятий.</p>
      </div>

      <div class="resource-link-layout" aria-label="Полезные ссылки">
        {linkGroups.map((group) => (
          <section class="resource-link-group" aria-labelledby={`resource-${group.id}`}>
            <h2 id={`resource-${group.id}`}>{group.title}</h2>
            {group.note && <p>{group.note}</p>}
            <ul class="resource-link-list">
              {group.links.map((link) => (
                <li class="resource-link-item">
                  <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  <p>{link.note}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
