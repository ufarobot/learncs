---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site.js';
import extraProfiles from '../../data/rating-extra-profiles.json';
import ratingHistory from '../../data/rating-history.json';
import schoolCatalog from '../../data/rating-school-catalog.json';
import {
  applySchoolCatalog,
  buildCompositeRegionRating,
  buildCompositeSchoolRating,
  buildOverallRegionRating
} from '../../lib/rating-school-catalog.js';

const title = 'Рейтинг школ по итогам ВсОШ';
const description = 'Рейтинг школ и регионов по результатам заключительного этапа ВсОШ по информатике, математике, физике и химии. Информатика представлена четырьмя профилями, программирование доступно с 2024 по 2026 год.';
const canonical = new URL('ratings/vsosh-schools/', site.url).href;
const currentYear = 2026;
const scoreFormatter = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 });
const programmingProfile = {
  id: 'programming',
  name: ratingHistory.profile,
  subject: 'Информатика',
  source: ratingHistory.sources[2026].protocol,
  years: applySchoolCatalog(ratingHistory.years, schoolCatalog)
};
const profiles = [
  programmingProfile,
  ...extraProfiles.profiles.map((profile) => ({
    ...profile,
    years: applySchoolCatalog(profile.years, schoolCatalog)
  }))
];
const profilesById = new Map(profiles.map((profile) => [profile.id, profile]));
const informaticsProfileIds = ['programming', 'ai', 'security', 'robotics'];
const informaticsProfiles = informaticsProfileIds.map((profileId) => {
  const profile = profilesById.get(profileId);
  if (!profile) {
    throw new Error(`Informatics rating references unknown profile ${profileId}`);
  }
  return profile;
});
const itRatingData = buildCompositeSchoolRating(informaticsProfiles, currentYear, {
  weightBy: 'school-score'
});
const informaticsRegionRating = buildOverallRegionRating(informaticsProfiles, currentYear);
const informaticsParticipantCount = informaticsProfiles.reduce((total, profile) => {
  const yearRating = profile.years.find((year) => year.year === currentYear);
  if (!yearRating) {
    throw new Error(`Profile ${profile.id} has no rating for ${currentYear}`);
  }
  return total + yearRating.participantCount;
}, 0);
profilesById.set('informatics', {
  id: 'informatics',
  name: 'Информатика',
  years: [{
    year: currentYear,
    participantCount: informaticsParticipantCount,
    schools: itRatingData.schools,
    regions: informaticsRegionRating.regions
  }]
});
const compositeDefinitions = [
  {
    id: 'overall',
    name: 'Информатика: 4 профиля',
    tableName: 'Общий рейтинг по информатике',
    profileIds: informaticsProfileIds,
    weightBy: 'school-score',
    precomputedRating: itRatingData,
    precomputedRegionRating: informaticsRegionRating,
    methodNote: 'В общем рейтинге по информатике вклад профиля зависит от общей суммы баллов его участников.',
    regionMethodNote: 'В общем рейтинге по информатике учитываются регионы из выбранных профилей.'
  },
  {
    id: 'stem',
    name: 'STEM: 4 предмета',
    tableName: 'Общий рейтинг STEM',
    profileIds: ['informatics', 'math', 'physics', 'chemistry'],
    weightBy: 'participants',
    methodNote: 'В общем рейтинге STEM информатика объединяет четыре профиля. Вес каждого предмета пропорционален числу участий в соответствующих протоколах финала.',
    regionMethodNote: 'В общем рейтинге STEM учитываются регионы из выбранных предметов. Предмет «Информатика» объединяет четыре профиля.'
  }
];
const compositeRatings = compositeDefinitions.map((definition) => {
  const { precomputedRating, precomputedRegionRating, ...definitionData } = definition;
  const compositeProfiles = definition.profileIds.map((profileId) => {
    const profile = profilesById.get(profileId);
    if (!profile) {
      throw new Error(`Composite rating ${definition.id} references unknown profile ${profileId}`);
    }
    return profile;
  });
  const ratingData = precomputedRating ?? buildCompositeSchoolRating(
    compositeProfiles,
    currentYear,
    { weightBy: definition.weightBy }
  );
  const regionRatingData = precomputedRegionRating ?? buildCompositeRegionRating(
    compositeProfiles,
    currentYear,
    { weightBy: definition.weightBy === 'participants' ? 'participants' : 'region-score' }
  );
  const visibleSchools = ratingData.schools.filter((school) => Math.round(school.score) > 10);

  return {
    ...definitionData,
    profiles: compositeProfiles,
    rating: {
      ...ratingData,
      schoolCount: visibleSchools.length,
      regionCount: new Set(visibleSchools.map((school) => school.region)).size
    },
    regionRating: regionRatingData
  };
});
const overallProfileLabels = {
  informatics: 'Информатика',
  programming: 'Программирование',
  ai: 'Искусственный интеллект',
  security: 'Информационная безопасность',
  robotics: 'Робототехника',
  math: 'Математика',
  physics: 'Физика',
  chemistry: 'Химия'
};
const overallColumnLabels = {
  informatics: 'Информ.',
  programming: 'Прог.',
  ai: 'ИИ',
  security: 'ИБ',
  robotics: 'Роботы',
  math: 'Матем.',
  physics: 'Физика',
  chemistry: 'Химия'
};
const compositeProfileLabel = (composite, profile) => (
  composite.id === 'stem' && profile.id === 'informatics'
    ? 'Информатика, 4 профиля'
    : overallProfileLabels[profile.id] ?? profile.name
);
const compositeColumnLabel = (composite, profile) => (
  composite.id === 'stem' && profile.id === 'informatics'
    ? 'Информ.'
    : overallColumnLabels[profile.id] ?? profile.name
);
const initialRating = programmingProfile.years.find((year) => year.year === currentYear);
const years = [...new Set(profiles.flatMap((profile) => profile.years.map((year) => year.year)))]
  .sort((left, right) => right - left);

const formatScore = (value) => scoreFormatter.format(Math.round(value));
const formatExactScore = (value) => value.toLocaleString('ru-RU', {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
});
const formatPercent = (value) => {
  const percent = value * 100;
  return Math.abs(percent) < 10
    ? percent.toLocaleString('ru-RU', { minimumFractionDigits: 1, maximumFractionDigits: 1 })
    : Math.round(percent).toLocaleString('ru-RU');
};
const changeDetails = (entry, previousYear) => {
  if (entry.changePercent === null) {
    return {
      label: 'нет сравнения',
      className: 'is-new',
      title: `В рейтинге за ${previousYear} год результата для сравнения нет`
    };
  }

  const percent = entry.changePercent * 100;
  if (Math.abs(percent) < 0.05) {
    return {
      label: '0%',
      className: 'is-flat',
      title: `Изменение относительно результата ${previousYear} года: 0%`
    };
  }

  const arrow = Math.abs(percent) >= 10
    ? (percent > 0 ? '↑↑' : '↓↓')
    : Math.abs(percent) >= 2
      ? (percent > 0 ? '↑' : '↓')
      : '';
  const formattedPercent = formatPercent(entry.changePercent);

  return {
    label: `${arrow ? `${arrow} ` : ''}${percent > 0 ? '+' : ''}${formattedPercent}%`,
    className: percent > 0 ? 'is-up' : 'is-down',
    title: `Изменение относительно результата ${previousYear} года: ${percent > 0 ? '+' : ''}${formattedPercent}%`
  };
};
const hasComparison = (yearRating) => yearRating.schools.some((school) => school.previousScore !== null);
const methodNote = (yearRating) => {
  if (yearRating.scoringMethod === 'result-category') {
    return `В официальном протоколе ${yearRating.participantCount} участников. В опубликованной таблице рейтинга за ${yearRating.year} год есть ${yearRating.schoolResultCount} записи, поэтому рейтинг школ и регионов построен по ним.`;
  }

  const notes = [`В протоколе ${yearRating.participantCount} участников.`];
  if (yearRating.disqualifiedCount > 0) {
    notes.push(`Дисквалифицировано: ${yearRating.disqualifiedCount}. Эти записи учитываются в числе участников, но дают 0 баллов.`);
  }
  if (yearRating.schoolResultCount === yearRating.participantCount) {
    notes.push('Рейтинг школ и регионов учитывает все записи.');
  } else {
    const missingSchools = yearRating.participantCount - yearRating.schoolResultCount;
    const missingLabel = missingSchools === 1 ? 'в одной записи' : `в ${missingSchools} записях`;
    notes.push(`Школа не указана ${missingLabel}. Рейтинг школ учитывает ${yearRating.schoolResultCount} записей, рейтинг регионов учитывает ${yearRating.participantCount}.`);
  }
  return notes.join(' ');
};

const datasetSchema = {
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  name: title,
  description,
  url: canonical,
  inLanguage: 'ru-RU',
  dateModified: extraProfiles.updatedAt,
  temporalCoverage: '2023/24–2025/26',
  spatialCoverage: {
    '@type': 'Country',
    name: 'Россия'
  },
  isBasedOn: profiles.map((profile) => profile.source),
  creator: {
    '@id': new URL('#organization', site.url).href
  },
  variableMeasured: [
    'Баллы рейтинга',
    'Победители',
    'Призеры',
    'Участники'
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={new URL('assets/og-rating-2026.png', site.url).href}
  ogImageAlt="Рейтинг школ по итогам ВсОШ 2026"
  courseSchema={false}
  basePath="../../"
  showHeaderCta={false}
  pageAudience="parents"
  extraStylesheets={['assets/rating.css?v=20260816-region-drilldown']}
  structuredData={[datasetSchema]}
>
  <article class="rating-page" data-ranking-app>
    <header class="rating-hero">
      <div class="container">
        <div class="rating-hero-copy">
          <h1>Рейтинг школ по итогам ВсОШ</h1>
          <p class="lead">
            В центре рейтинга олимпиадное программирование. Также доступны четыре профиля информатики и общий рейтинг STEM по информатике, математике, физике и химии.
          </p>
        </div>
      </div>
    </header>

    <section class="rating-tool-section" aria-labelledby="rating-table-title">
      <div class="container">
        <h2 class="visually-hidden" id="rating-table-title">Таблица рейтинга</h2>

        <div class="ranking-sticky-header">
          <div class="ranking-controls">
          <label class="ranking-field ranking-profile">
            <span>Предмет или профиль</span>
            <select data-ranking-profile>
              <optgroup label="Информатика">
                <option value="overall">Общий рейтинг по информатике</option>
                <option value="programming" selected>Программирование</option>
                {profiles
                  .filter((profile) => ['ai', 'security', 'robotics'].includes(profile.id))
                  .map((profile) => (
                    <option value={profile.id}>{profile.name}</option>
                  ))}
              </optgroup>
              <optgroup label="STEM">
                <option value="stem">Общий рейтинг STEM</option>
                <option value="math">Математика</option>
                <option
                  value="stem-informatics"
                  data-ranking-profile-alias="overall"
                >
                  Информатика, 4 профиля
                </option>
                {profiles
                  .filter((profile) => ['physics', 'chemistry'].includes(profile.id))
                  .map((profile) => (
                    <option value={profile.id}>{profile.name}</option>
                  ))}
              </optgroup>
            </select>
          </label>

          <div class="ranking-control-group ranking-year-control">
            <span>Год</span>
            <div class="ranking-years" aria-label="Год рейтинга" style={`--year-count: ${years.length}`}>
              {years.map((year) => (
                <button
                  type="button"
                  aria-pressed={year === currentYear ? 'true' : 'false'}
                  data-ranking-year-button={year}
                >
                  {year}
                </button>
              ))}
            </div>
          </div>

          <div class="ranking-control-group ranking-view-control">
            <span>Рейтинг</span>
            <div class="ranking-tabs" role="tablist" aria-label="Вид рейтинга">
              <button
                id="ranking-tab-schools"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls={`ranking-panel-programming-${currentYear}-schools`}
                data-ranking-tab="schools"
              >
                Школы
              </button>
              <button
                id="ranking-tab-regions"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls={`ranking-panel-programming-${currentYear}-regions`}
                data-ranking-tab="regions"
                tabindex="-1"
              >
                Регионы
              </button>
            </div>
          </div>

          <label class="ranking-field ranking-search">
            <span>Поиск</span>
            <input
              type="search"
              placeholder="Название школы"
              autocomplete="off"
              data-ranking-search
            />
          </label>

          <label class="ranking-field ranking-region-filter" data-ranking-region-field>
            <span>Регион</span>
            <select data-ranking-region>
              <option value="">Все регионы</option>
            </select>
          </label>

          <button class="ranking-reset" type="button" data-ranking-reset>
            Сбросить
          </button>

            {compositeRatings.map((composite) => (
              <div
                class="ranking-profile-options"
                data-ranking-overall-options={composite.id}
                hidden
              >
                <span>{composite.id === 'stem' ? 'Предметы' : 'Профили'}</span>
                <div>
                  {composite.rating.profileOptions.map((profile) => (
                    <label>
                      <input
                        type="checkbox"
                        value={profile.id}
                        checked
                        data-ranking-overall-profile
                        data-ranking-overall-school-total={profile.scoreTotal}
                        data-ranking-overall-school-weight={profile.weight}
                        data-ranking-overall-region-total={composite.regionRating.profileOptions.find((item) => item.id === profile.id)?.scoreTotal}
                        data-ranking-overall-region-weight={composite.regionRating.profileOptions.find((item) => item.id === profile.id)?.weight}
                      />
                      <span>{compositeProfileLabel(composite, profile)}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="ranking-status">
            <span data-ranking-count aria-live="polite">{initialRating.schoolCount} школ</span>
            <a class="ranking-method-link" href="#rating-method">Методика</a>
          </div>
        </div>

        {compositeRatings.map((composite) => (
          <div
            id={`ranking-panel-${composite.id}-${currentYear}-schools`}
            class="ranking-panel"
            role="tabpanel"
            aria-labelledby="ranking-tab-schools"
            data-ranking-panel="schools"
            data-ranking-profile={composite.id}
            data-ranking-profile-name={composite.tableName}
            data-ranking-year={currentYear}
            data-ranking-method-note={composite.methodNote}
            data-ranking-overall-minimum-score="10"
            data-ranking-overall-round-threshold="true"
            data-ranking-school-count={composite.rating.schoolCount}
            data-ranking-region-count={composite.rating.regionCount}
            hidden
          >
            <div class="ranking-table-frame">
              <table class="ranking-table ranking-table-schools ranking-table-overall ranking-table-no-comparison">
                <caption class="visually-hidden">{composite.tableName} по итогам ВсОШ, {currentYear} год</caption>
                <thead>
                  <tr>
                    <th scope="col">Место</th>
                    <th scope="col">Школа</th>
                    <th scope="col">Регион</th>
                    <th scope="col">Общий балл</th>
                    {composite.rating.profileOptions.map((profile) => (
                      <th
                        scope="col"
                        title={profile.name}
                        data-ranking-overall-column={profile.id}
                      >
                        {compositeColumnLabel(composite, profile)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody data-ranking-overall-body>
                  {composite.rating.schools.map((school) => (
                    <tr
                      data-ranking-row
                      data-ranking-overall-row
                      data-ranking-included={Math.round(school.score) > 10 ? 'true' : 'false'}
                      data-ranking-overall={JSON.stringify(school.profiles)}
                      data-query={`${school.name} ${school.city ?? ''} ${school.region} ${school.aliases.join(' ')}`}
                      data-region={school.region}
                    >
                      <td class="ranking-rank" data-label="Место" data-ranking-overall-rank>{school.rank}</td>
                      <th class="ranking-entity" scope="row" title={school.officialName}>{school.name}</th>
                      <td class="ranking-region" data-label="Регион">{school.region}</td>
                      <td
                        class="ranking-score ranking-score-current"
                        data-label="Общий балл"
                        data-ranking-overall-score
                        title={`${formatExactScore(school.score)} балла`}
                      >
                        {formatScore(school.score)}
                      </td>
                      {composite.rating.profileOptions.map((profile) => {
                        const contribution = composite.rating.weightTotal === 0 || profile.scoreTotal === 0
                          ? 0
                          : ((school.profiles[profile.id]?.score ?? 0) / profile.scoreTotal)
                            * (profile.weight / composite.rating.weightTotal) * 10000;
                        return (
                          <td
                            class="ranking-score ranking-overall-contribution"
                            data-label={compositeProfileLabel(composite, profile)}
                            data-ranking-overall-column={profile.id}
                            data-ranking-overall-contribution={profile.id}
                            title={`${formatExactScore(contribution)} балла`}
                          >
                            {formatScore(contribution)}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="ranking-empty" data-ranking-empty hidden>По вашему запросу ничего не найдено.</p>
          </div>
        ))}

        {compositeRatings.map((composite) => (
          <div
            id={`ranking-panel-${composite.id}-${currentYear}-regions`}
            class="ranking-panel"
            role="tabpanel"
            aria-labelledby="ranking-tab-regions"
            data-ranking-panel="regions"
            data-ranking-profile={composite.id}
            data-ranking-profile-name={composite.tableName}
            data-ranking-year={currentYear}
            data-ranking-method-note={composite.regionMethodNote}
            data-ranking-overall-minimum-score="0"
            data-ranking-overall-inclusion="participants"
            data-ranking-region-count={composite.regionRating.regionCount}
            hidden
          >
            <div class="ranking-table-frame">
              <table class="ranking-table ranking-table-regions ranking-table-overall ranking-table-overall-regions ranking-table-no-comparison">
                <caption class="visually-hidden">{composite.tableName} по регионам по итогам ВсОШ, {currentYear} год</caption>
                <thead>
                  <tr>
                    <th scope="col">Место</th>
                    <th scope="col">Регион</th>
                    <th scope="col">Общий балл</th>
                    {composite.regionRating.profileOptions.map((profile) => (
                      <th
                        scope="col"
                        title={profile.name}
                        data-ranking-overall-column={profile.id}
                      >
                        {compositeColumnLabel(composite, profile)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody data-ranking-overall-body>
                  {composite.regionRating.regions.map((region) => (
                    <tr
                      data-ranking-row
                      data-ranking-overall-row
                      data-ranking-included="true"
                      data-ranking-overall={JSON.stringify(region.profiles)}
                      data-query={region.name}
                    >
                      <td class="ranking-rank" data-label="Место" data-ranking-overall-rank>{region.rank}</td>
                      <th class="ranking-entity" scope="row">
                        <button
                          class="ranking-region-link"
                          type="button"
                          data-ranking-region-link={region.name}
                          aria-label={`Показать школы региона «${region.name}»`}
                        >
                          {region.name}
                        </button>
                      </th>
                      <td
                        class="ranking-score ranking-score-current"
                        data-label="Общий балл"
                        data-ranking-overall-score
                        title={`${formatExactScore(region.score)} балла`}
                      >
                        {formatScore(region.score)}
                      </td>
                      {composite.regionRating.profileOptions.map((profile) => {
                        const contribution = composite.regionRating.weightTotal === 0
                          || profile.scoreTotal === 0
                          ? 0
                          : ((region.profiles[profile.id]?.score ?? 0) / profile.scoreTotal)
                            * (profile.weight / composite.regionRating.weightTotal) * 10000;
                        return (
                          <td
                            class="ranking-score ranking-overall-contribution"
                            data-label={compositeProfileLabel(composite, profile)}
                            data-ranking-overall-column={profile.id}
                            data-ranking-overall-contribution={profile.id}
                            title={`${formatExactScore(contribution)} балла`}
                          >
                            {formatScore(contribution)}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="ranking-empty" data-ranking-empty hidden>По вашему запросу ничего не найдено.</p>
          </div>
        ))}

        {profiles.map((profile) => profile.years.map((yearRating) => {
          const comparison = hasComparison(yearRating);
          const previousYear = yearRating.year - 1;
          const participationNote = methodNote(yearRating);

          return (
            <>
              <div
                id={`ranking-panel-${profile.id}-${yearRating.year}-schools`}
                class="ranking-panel"
                role="tabpanel"
                aria-labelledby="ranking-tab-schools"
                data-ranking-panel="schools"
                data-ranking-profile={profile.id}
                data-ranking-profile-name={profile.name}
                data-ranking-year={yearRating.year}
                data-ranking-method-note={participationNote}
                data-ranking-participant-count={yearRating.participantCount}
                data-ranking-school-count={yearRating.schoolCount}
                data-ranking-region-count={yearRating.regionCount}
                hidden={!(profile.id === 'programming' && yearRating.year === currentYear)}
              >
                <div class="ranking-table-frame">
                  <table class={`ranking-table ranking-table-schools ${comparison ? '' : 'ranking-table-no-comparison'}`}>
                    <caption class="visually-hidden">Рейтинг школ по итогам ВсОШ, {profile.name}, {yearRating.year} год</caption>
                    <thead>
                      <tr>
                        <th scope="col">Место</th>
                        <th scope="col">Школа</th>
                        <th scope="col">Регион</th>
                        <th scope="col">{yearRating.year}</th>
                        {comparison && <th scope="col">{previousYear}</th>}
                        {comparison && <th scope="col">Изменение</th>}
                        <th scope="col">Победители</th>
                        <th scope="col">Призеры</th>
                        <th scope="col">Участники</th>
                      </tr>
                    </thead>
                    <tbody>
                      {yearRating.schools.map((school) => {
                        const change = comparison ? changeDetails(school, previousYear) : null;
                        return (
                          <tr
                            data-ranking-row
                            data-query={`${school.name} ${school.city ?? ''} ${school.region} ${school.aliases.join(' ')}`}
                            data-region={school.region}
                          >
                            <td class="ranking-rank" data-label="Место">{school.rank}</td>
                            <th class="ranking-entity" scope="row" title={school.officialName}>{school.name}</th>
                            <td class="ranking-region" data-label="Регион">{school.region}</td>
                            <td
                              class="ranking-score ranking-score-current"
                              data-label={`Баллы ${yearRating.year}`}
                              title={`${formatExactScore(school.score)} балла`}
                            >
                              {formatScore(school.score)}
                            </td>
                            {comparison && (
                              <td
                                class="ranking-score ranking-score-previous"
                                data-label={`Баллы ${previousYear}`}
                                title={school.previousScore !== null ? `${formatExactScore(school.previousScore)} балла` : undefined}
                              >
                                {school.previousScore !== null ? formatScore(school.previousScore) : 'нет'}
                              </td>
                            )}
                            {comparison && change && (
                              <td
                                class={`ranking-change ${change.className}`}
                                data-label={`Изменение к ${previousYear}`}
                                title={change.title}
                              >
                                {change.label}
                              </td>
                            )}
                            <td class="ranking-result" data-label="Победители">{school.winners}</td>
                            <td class="ranking-result" data-label="Призеры">{school.prizewinners}</td>
                            <td class="ranking-result ranking-participants" data-label="Участники">
                              {school.participants}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <p class="ranking-empty" data-ranking-empty hidden>По вашему запросу ничего не найдено.</p>
              </div>

              <div
                id={`ranking-panel-${profile.id}-${yearRating.year}-regions`}
                class="ranking-panel"
                role="tabpanel"
                aria-labelledby="ranking-tab-regions"
                data-ranking-panel="regions"
                data-ranking-profile={profile.id}
                data-ranking-profile-name={profile.name}
                data-ranking-year={yearRating.year}
                data-ranking-method-note={participationNote}
                data-ranking-participant-count={yearRating.participantCount}
                data-ranking-school-count={yearRating.schoolCount}
                data-ranking-region-count={yearRating.regionCount}
                hidden
              >
                <div class="ranking-table-frame">
                  <table class={`ranking-table ranking-table-regions ${comparison ? '' : 'ranking-table-no-comparison'}`}>
                    <caption class="visually-hidden">Рейтинг регионов по итогам ВсОШ, {profile.name}, {yearRating.year} год</caption>
                    <thead>
                      <tr>
                        <th scope="col">Место</th>
                        <th scope="col">Регион</th>
                        <th scope="col">{yearRating.year}</th>
                        {comparison && <th scope="col">{previousYear}</th>}
                        {comparison && <th scope="col">Изменение</th>}
                        <th scope="col">Победители</th>
                        <th scope="col">Призеры</th>
                        <th scope="col">Участники</th>
                      </tr>
                    </thead>
                    <tbody>
                      {yearRating.regions.map((region) => {
                        const change = comparison ? changeDetails(region, previousYear) : null;
                        return (
                          <tr data-ranking-row data-query={region.name}>
                            <td class="ranking-rank" data-label="Место">{region.rank}</td>
                            <th class="ranking-entity" scope="row">
                              <button
                                class="ranking-region-link"
                                type="button"
                                data-ranking-region-link={region.name}
                                aria-label={`Показать школы региона «${region.name}»`}
                              >
                                {region.name}
                              </button>
                            </th>
                            <td
                              class="ranking-score ranking-score-current"
                              data-label={`Баллы ${yearRating.year}`}
                              title={`${formatExactScore(region.score)} балла`}
                            >
                              {formatScore(region.score)}
                            </td>
                            {comparison && (
                              <td
                                class="ranking-score ranking-score-previous"
                                data-label={`Баллы ${previousYear}`}
                                title={region.previousScore !== null ? `${formatExactScore(region.previousScore)} балла` : undefined}
                              >
                                {region.previousScore !== null ? formatScore(region.previousScore) : 'нет'}
                              </td>
                            )}
                            {comparison && change && (
                              <td
                                class={`ranking-change ${change.className}`}
                                data-label={`Изменение к ${previousYear}`}
                                title={change.title}
                              >
                                {change.label}
                              </td>
                            )}
                            <td class="ranking-result" data-label="Победители">{region.winners}</td>
                            <td class="ranking-result" data-label="Призеры">{region.prizewinners}</td>
                            <td class="ranking-result ranking-participants" data-label="Участники">
                              {region.participants}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <p class="ranking-empty" data-ranking-empty hidden>По вашему запросу ничего не найдено.</p>
              </div>
            </>
          );
        }))}
      </div>
    </section>

    <section id="rating-method" class="rating-method" aria-labelledby="rating-method-title">
      <div class="container rating-method-layout">
        <div>
          <p class="pretitle">Как считали</p>
          <h2 id="rating-method-title">Методика</h2>
        </div>

        <div class="rating-method-content">
          <div class="rating-method-purpose">
            <h3>Цели рейтинга</h3>
            <ul>
              <li>Показать сильные школы и регионы по каждому предмету и профилю.</li>
              <li>Сравнить результаты по годам.</li>
              <li>Собрать сводные рейтинги по выбранным профилям и предметам.</li>
            </ul>
            <p>
              Рейтинг учитывает только результаты заключительного этапа ВсОШ и не оценивает
              школу в целом.
            </p>
          </div>
          <ol>
            <li>
              <strong>Считаем базовый балл участника.</strong>
              Первое место получает 100 баллов, последнее 0. Для остальных мест действует
              формула:
              <span class="rating-method-formula">
                100 × (число участников в рейтинге − место) /
                (число участников в рейтинге − 1)
              </span>
              При одинаковом результате используем среднее из занятых мест.
              Дисквалифицированному участнику место не присваивается, его балл равен 0.
            </li>
            <li>
              <strong>Учитываем класс.</strong>
              Базовый балл умножаем на коэффициент: 6-й класс × 1,8; 7-й × 1,6;
              8-й × 1,4; 9-й × 1,2; 10-й × 1; 11-й × 0,8. Например, 11-е место
              среди 101 участника дает 90 базовых баллов. Ученик 8-го класса получает
              90 × 1,4 = 126 баллов.
            </li>
            <li>
              <strong>Складываем баллы.</strong>
              Балл школы равен сумме баллов ее участников. Балл региона считается так же
              по всем участникам региона. Статус победителя или призёра показывается
              в таблице, но отдельного бонуса не даёт.
            </li>
            <li>
              <strong>Сравниваем годы.</strong>
              Сравнение доступно только для лет с одинаковой методикой. Чтобы сравнить годы
              с разной общей суммой баллов, балл прошлого года пересчитываем по формуле:
              <span class="rating-method-formula">
                балл прошлого года × (сумма баллов текущего года / сумма баллов прошлого года)
              </span>
              Для школ и регионов пересчет выполняется отдельно. Места внутри каждого года
              не меняются. Изменение показывает, как изменилась доля школы или региона
              в общей сумме баллов.
            </li>
            <li>
              <strong>Считаем общий рейтинг по информатике.</strong>
              Внутри общего рейтинга по информатике сохраняется прежняя формула. Складываем баллы
              школы по программированию, искусственному интеллекту, информационной
              безопасности и робототехнике. Затем переводим результат в общую шкалу:
              <span class="rating-method-formula">
                10 000 × баллы школы / баллы всех школ в выбранных профилях
              </span>
              Рейтинг регионов считаем так же: складываем баллы региона и делим
              на сумму баллов всех регионов в выбранных профилях.
              Например, школа набрала 250 баллов, а все школы по выбранным профилям
              набрали 25 000. Общий балл школы равен 100. До отсечения школ сумма общего
              рейтинга равна 10 000. Вклад профиля определяется суммой баллов его
              участников: чем она больше, тем больше вклад.
            </li>
            <li>
              <strong>Считаем общий рейтинг STEM.</strong>
              Сначала определяем долю школы в общей сумме баллов по каждому предмету.
              Информатика как предмет объединяет четыре профиля и рассчитывается
              по формуле общего рейтинга по информатике из предыдущего шага. Для веса информатики
              складываем число участий в четырёх протоколах финала: программирование 488,
              искусственный интеллект 248, информационная безопасность 244,
              робототехника 246. Всего для информатики учитывается 1226 записей
              об участии. Один ученик может быть указан в нескольких протоколах.
              Затем доли предметов взвешиваем по числу записей об участии в протоколах
              финала: информатика 1226, математика 499, физика 501, химия 490. Всего
              для расчёта весов учитывается 2716 участий. Веса составляют: информатика
              45,14%, математика 18,37%, физика 18,45%, химия 18,04%.
              <span class="rating-method-formula">
                10 000 × (доля школы по информатике × 1226 + доля школы по математике × 499 +
                доля школы по физике × 501 + доля школы по химии × 490) / 2716
              </span>
              Рейтинг регионов STEM рассчитываем по той же двухуровневой формуле:
              сначала определяем долю региона в сумме баллов по каждому предмету,
              затем применяем те же веса предметов.
              Если предмет отключён, веса остальных пересчитываются в той же пропорции.
              Для следующего года веса будут пересчитаны по числу участий в новых протоколах.
            </li>
            <li>
              Если школа или регион в выбранном профиле или предмете не участвовали,
              их балл равен нулю. В сводных таблицах после округления остаются школы
              с общим баллом больше 10. При изменении набора профилей или предметов рейтинг
              и порог пересчитываются.
            </li>
          </ol>
          <p data-ranking-method-note-target>
            {methodNote(initialRating)}
          </p>
          <p data-ranking-history-note hidden>
            В 2024 году использовалась первая версия методики с фиксированными баллами
            за статус и класс. В таблице за 2024 год показаны опубликованные тогда баллы,
            без сравнения с 2025 годом.
          </p>
          <nav class="rating-sources" aria-label="Источники рейтинга">
            {profiles.map((profile) => (
              <a href={profile.source} target="_blank" rel="noopener noreferrer">
                Протокол «{profile.name}»
              </a>
            ))}
            <a href={ratingHistory.sources[2026].spreadsheet} target="_blank" rel="noopener noreferrer">
              Таблица по программированию 2026
            </a>
            <a href={ratingHistory.sources[2025].post} target="_blank" rel="noopener noreferrer">
              Рейтинг 2025
            </a>
            <a href={ratingHistory.sources[2024].post} target="_blank" rel="noopener noreferrer">
              Рейтинг 2024
            </a>
            <a href={ratingHistory.sources.channel} target="_blank" rel="noopener noreferrer">
              Канал «Как вырастить айтишника»
            </a>
          </nav>
        </div>
      </div>
    </section>
  </article>

  <script is:inline src="../../assets/rating.js?v=20260816-region-drilldown"></script>
</BaseLayout>
